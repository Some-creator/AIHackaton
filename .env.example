ANTHROPIC_API_KEY=
ANTHROPIC_SONNET_MODEL=claude-sonnet-4-6
# Agent 3 competitor search — use Google Places, Firecrawl web search, or both (mock if neither is set)
GOOGLE_PLACES_API_KEY=
YELP_API_KEY=
FIRECRAWL_API_KEY=
APIFY_API_KEY=
SENDGRID_API_KEY=
PORT=3001

# Firebase backend (Firestore) — paste full service account JSON as a single line, or use individual fields
FIREBASE_SERVICE_ACCOUNT=
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Firebase frontend (Auth) — set the same values in frontend/.env with VITE_ prefix for the React app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to true to force mock data even when API keys are present
USE_MOCK=false
